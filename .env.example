# Local development example. Never commit real secrets.
REGTRACE_ENVIRONMENT=development
REGTRACE_API_KEY=replace-with-a-project-api-key
REGTRACE_ADMIN_API_KEY=replace-with-an-admin-api-key
REGTRACE_WEBHOOK_MASTER_SECRET=replace-with-at-least-32-random-bytes
REGTRACE_EXECUTION_GRANT_SECRET=replace-with-a-distinct-32-byte-random-secret

# Used by the Python SDK, not by the API server.
REGTRACE_BASE_URL=http://localhost:8000

REGTRACE_TRUSTED_HOSTS=localhost,127.0.0.1,::1
REGTRACE_CORS_ALLOWED_ORIGINS=http://localhost:3000
REGTRACE_ENFORCE_HTTPS=false
REGTRACE_EXPOSE_DOCS=true

REGTRACE_RATE_LIMIT_ENABLED=true
REGTRACE_RATE_LIMIT_WINDOW_SECONDS=60
REGTRACE_AUTHORIZATION_RATE_LIMIT=300
REGTRACE_TENANT_RATE_LIMIT=600
REGTRACE_ADMIN_RATE_LIMIT=300
REGTRACE_MAX_REQUEST_BODY_BYTES=1048576
REGTRACE_APPROVAL_TTL_SECONDS=86400
REGTRACE_EXECUTION_GRANT_TTL_SECONDS=300
REGTRACE_LOG_LEVEL=INFO
