# Local development example. Never commit real secrets.
DECAUSTRUM_ENVIRONMENT=development
# Development/test bootstrap and SDK client key only; unset on production servers.
# Production project keys are issued by the admin API; see docs/operations.md.
# Changing this local bootstrap value does not revoke older keys.
# Generate a current-format key with app.api_keys.generate_project_api_key().
# Old opaque keys are retired on upgrade; see docs/operations.md.
DECAUSTRUM_API_KEY=replace-with-a-project-api-key
DECAUSTRUM_ADMIN_API_KEY=replace-with-an-admin-api-key
DECAUSTRUM_WEBHOOK_MASTER_SECRET=replace-with-at-least-32-random-bytes
DECAUSTRUM_EXECUTION_GRANT_SECRET=replace-with-a-distinct-32-byte-random-secret

# Used by the Python SDK, not by the API server. Provision the reviewer value
# through the admin API before running the protected-transfer example.
DECAUSTRUM_BASE_URL=http://localhost:8000
DECAUSTRUM_REVIEWER_API_KEY=replace-with-a-reviewer-api-key
DECAUSTRUM_PORT=8000

DECAUSTRUM_TRUSTED_HOSTS=localhost,127.0.0.1,::1
DECAUSTRUM_CORS_ALLOWED_ORIGINS=http://localhost:3000
DECAUSTRUM_ENFORCE_HTTPS=false
DECAUSTRUM_EXPOSE_DOCS=true

DECAUSTRUM_RATE_LIMIT_ENABLED=true
DECAUSTRUM_RATE_LIMIT_WINDOW_SECONDS=60
DECAUSTRUM_AUTHORIZATION_RATE_LIMIT=300
DECAUSTRUM_TENANT_RATE_LIMIT=600
DECAUSTRUM_ADMIN_RATE_LIMIT=300
DECAUSTRUM_MAX_REQUEST_BODY_BYTES=1048576
DECAUSTRUM_APPROVAL_TTL_SECONDS=86400
DECAUSTRUM_EXECUTION_GRANT_TTL_SECONDS=300
DECAUSTRUM_LOG_LEVEL=INFO
